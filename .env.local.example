# ============================================================
# AI Headshot Generator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your API keys.
# NEVER commit .env.local to version control!
# ============================================================

# --- ImgBB API ---
# Get your free API key at: https://api.imgbb.com/
# Steps:
#   1. Go to https://imgbb.com and create a free account
#   2. Visit https://api.imgbb.com/ and click "Get API Key"
#   3. Copy the key below
IMGBB_API_KEY="442fe9916766db7ee3240b8b2c973872"

# --- Replicate API ---
# Get your free API token at: https://replicate.com/
# Steps:
#   1. Sign up at https://replicate.com (free tier available)
#   2. Go to https://replicate.com/account/api-tokens
#   3. Create a new token and paste it below
REPLICATE_API_TOKEN=your_replicate_api_token_here

# --- Optional: Site URL (used for SEO) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
